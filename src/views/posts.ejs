<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Social Media - Posts</title>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
</head>
<body class="grey lighten-4">
  <nav>
    <div class="nav-wrapper teal">
      <a href="/" class="brand-logo center">Social Media</a>
    </div>
  </nav>

  <div class="container" style="margin-top: 30px;">
    <div class="row valign-wrapper">
      <div class="col s8">
        <h4>Publicaciones</h4>
      </div>
      <div class="col s4 right-align">
        <a href="/posts/create" class="btn waves-effect waves-light green darken-1">
          <i class="material-icons left">add</i> Nueva
        </a>
      </div>
    </div>

    <div class="row">
      <% if (posts && posts.length > 0) { %>
        <% posts.forEach(post => { %>
          <div class="col s12 m6 l4">
            <div class="card medium">
              <div class="card-image">
                <img src="<%= post.imageUrl || 'https://via.placeholder.com/300x200?text=Sin+Imagen' %>" alt="Post Image">
              </div>
              <div class="card-content">
                <span class="card-title"><%= post.title %></span>
                <p><%= post.content %></p>
                <div style="margin-top: 10px;">
                  <% if (post.hashtags) { %>
                    <% post.hashtags.forEach(tag => { %>
                      <span class="chip">#<%= tag %></span>
                    <% }) %>
                  <% } %>
                </div>
              </div>
              <div class="card-action">
                <span><strong>Autor:</strong> <%= post.user ? post.user.name + ' ' + post.user.lastName : 'Anónimo' %></span>
                <div class="right">
                  <a href="/posts/edit/<%= post._id %>" class="btn-flat p-0"><i class="material-icons teal-text">edit</i></a>
                  <form action="/posts/delete/<%= post._id %>" method="POST" style="display:inline;">
                    <button type="submit" class="btn-flat p-0" onclick="return confirm('¿Eliminar esta publicación?')">
                      <i class="material-icons red-text">delete</i>
                    </button>
                  </form>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="col s12 center-align">
          <p class="flow-text">No hay publicaciones disponibles.</p>
        </div>
      <% } %>
    </div>
  </div>
</body>
</html>
