<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Publicaciones | Social Space</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <script>tailwind.config = { theme: { extend: { fontFamily: { sans: ['Plus Jakarta Sans', 'sans-serif'] } } } };</script>
</head>
<body class="min-h-screen bg-slate-950 font-sans text-slate-100">
  <div class="min-h-screen bg-[radial-gradient(circle_at_50%_0%,rgba(99,102,241,0.12),transparent_34%)]">
    <nav class="border-b border-white/10 bg-slate-950/80 backdrop-blur-xl"><div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-5 lg:px-10">
      <a href="/" class="flex items-center gap-3 text-sm font-extrabold"><span class="flex h-9 w-9 items-center justify-center rounded-xl bg-gradient-to-br from-indigo-500 to-fuchsia-500"><i class="fa-solid fa-layer-group"></i></span> social<span class="text-indigo-400">/</span>space</a>
      <a href="/posts/create" class="inline-flex items-center gap-2 rounded-xl bg-indigo-500 px-4 py-2.5 text-sm font-bold shadow-lg shadow-indigo-500/20 transition hover:bg-indigo-400"><i class="fa-solid fa-plus"></i> Nueva publicación</a>
    </div></nav>
    <main class="mx-auto max-w-7xl px-6 py-12 lg:px-10 lg:py-16">
      <header class="mb-10 flex flex-col justify-between gap-5 sm:flex-row sm:items-end"><div><p class="mb-3 text-xs font-bold uppercase tracking-[0.2em] text-indigo-400">Social feed</p><h1 class="text-4xl font-extrabold tracking-[-0.04em] text-white">Publicaciones</h1><p class="mt-3 text-slate-400">Ideas, notas y conversaciones de tu espacio.</p></div><div class="text-sm text-slate-500"><i class="fa-solid fa-signal mr-2 text-emerald-400"></i> Comunidad activa</div></header>
      <% if (posts.length === 0) { %>
        <section class="rounded-3xl border border-dashed border-white/15 bg-white/[0.03] px-6 py-20 text-center"><div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-indigo-500/10 text-2xl text-indigo-300"><i class="fa-regular fa-comment-dots"></i></div><h2 class="mt-6 text-xl font-bold text-white">Todavía no hay publicaciones</h2><p class="mx-auto mt-2 max-w-md text-sm leading-6 text-slate-400">Sé la primera persona en compartir una idea con la comunidad.</p><a href="/posts/create" class="mt-7 inline-flex items-center gap-2 rounded-xl bg-white px-5 py-3 text-sm font-bold text-slate-950 transition hover:bg-indigo-100"><i class="fa-solid fa-plus"></i> Crear publicación</a></section>
      <% } %>
      <section class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
      <% posts.forEach(post => { %>
        <article class="group flex min-h-[390px] flex-col overflow-hidden rounded-2xl border border-white/10 bg-white/[0.045] shadow-2xl shadow-black/10 backdrop-blur-xl transition duration-300 hover:-translate-y-1 hover:border-indigo-400/40 hover:bg-white/[0.07]">
          <div class="relative h-48 overflow-hidden bg-gradient-to-br from-indigo-950 via-slate-900 to-fuchsia-950">
            <img src="<%= post.imageUrl || 'https://images.unsplash.com/photo-1557682250-33bd709cbe85?auto=format&fit=crop&w=900&q=80' %>" alt="Imagen de <%= post.title %>" class="h-full w-full object-cover opacity-80 transition duration-500 group-hover:scale-105" onerror="this.src='https://images.unsplash.com/photo-1557682250-33bd709cbe85?auto=format&fit=crop&w=900&q=80';">
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 to-transparent"></div>
            <span class="absolute bottom-4 left-4 rounded-full border border-white/15 bg-slate-950/70 px-3 py-1 text-[10px] font-bold uppercase tracking-wider text-indigo-200 backdrop-blur">Post #<%= String(post._id).slice(-5) %></span>
          </div>
          <div class="flex flex-1 flex-col p-5"><h2 class="line-clamp-1 text-lg font-bold text-white"><%= post.title %></h2><p class="mt-3 line-clamp-3 text-sm leading-6 text-slate-400"><%= post.content %></p>
            <% if (post.hashtags && post.hashtags.length) { %><div class="mt-4 flex flex-wrap gap-2"><% post.hashtags.forEach(hashtag => { %><span class="rounded-md border border-indigo-400/20 bg-indigo-400/10 px-2 py-1 text-[11px] font-semibold text-indigo-300">#<%= hashtag.replace(/^#/, "") %></span><% }) %></div><% } %>
            <div class="mt-auto flex items-center justify-between border-t border-white/10 pt-5"><div class="flex min-w-0 items-center gap-3"><div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-indigo-400 to-fuchsia-500 text-xs font-extrabold text-white"><%= post.user ? `${post.user.name.charAt(0)}${post.user.lastName.charAt(0)}` : "?" %></div><div class="min-w-0"><p class="truncate text-xs font-bold text-slate-300"><%= post.user ? `${post.user.name} ${post.user.lastName}` : "Desconocido" %></p><p class="text-[11px] text-slate-500"><%= post.createdAt ? new Date(post.createdAt).toLocaleDateString('es-ES') : 'Sin fecha' %></p></div></div><div class="flex items-center gap-1"><a href="/posts/edit/<%= post._id %>" title="Editar" class="flex h-9 w-9 items-center justify-center rounded-lg text-slate-400 transition hover:bg-indigo-400/15 hover:text-indigo-300"><i class="fa-solid fa-pen text-xs"></i></a><form action="/posts/delete/<%= post._id %>" method="POST" class="inline"><button type="submit" title="Eliminar" onclick="return confirm('¿Eliminar esta publicación?')" class="flex h-9 w-9 items-center justify-center rounded-lg text-slate-400 transition hover:bg-rose-400/15 hover:text-rose-300"><i class="fa-solid fa-trash text-xs"></i></button></form></div></div>
          </div>
        </article>
      <% }) %>
      </section>
    </main>
  </div>
</body>
</html>
